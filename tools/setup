#!/usr/bin/env python3
"""Install Spec Kit and this standard into a project's git-ignored paths.

Usage: tools/setup [--project DIR] [--check]

Setup never builds in place. It builds the complete installation in a stage
under `.ballast/setup/`, validates it, then switches it in entry by entry,
keeping each previous entry until the new installation verifies. A journal in
operator state records the attempt, so after a failure or a killed process the
next run rolls an unfinished switch back, or finishes one that had committed:
the checkout always holds a complete previous or a complete new installation.
The installation record next to it (`installation.json`) says what was
installed, by content.

`--check` reports `current`, `absent`, `interrupted: ...`, `stale`,
`stale: pinned ..., installed ...`, `incomplete: <path>` or `modified: <path>`
and writes nothing.

The project commits `ballast.toml` and its own overrides only. Everything this
script writes is rebuildable and must be ignored; see GITIGNORE below.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
import tomllib
import urllib.request
from datetime import UTC, datetime
from importlib.util import module_from_spec, spec_from_file_location
from pathlib import Path
from typing import NoReturn

STANDARD = Path(__file__).resolve().parent.parent
PATCHES = STANDARD / "tools/spec-kit"
# The launcher of this same standard version owns operator state: its
# location, the digest format, the checkout lock and the record reader.
# `--check` runs as a read-only probe: never write bytecode next to it.
sys.dont_write_bytecode = True
_spec = spec_from_file_location(
    "ballast_launcher", STANDARD / "tools/spec_workflow/launcher.py"
)
launcher = module_from_spec(_spec)
_spec.loader.exec_module(launcher)
VERSION = "1.0.11"
SOURCES = {
    "core": ("github/spec-kit", "8147943512404afb9d99c6252cb9bf84369fd0b0"),
    "multi-model-review": (
        "formin/multi-model-review",
        "9762e3e8c6af1d5d0d24d1dfae34132f3bc8f2e0",
    ),
    "status-report": (
        "Open-Agent-Tools/spec-kit-status",
        "fc66e82d717660376f0c6ed6f1be962951033414",
    ),
    "intent": (
        "SuhaibAslam/spec-kit-reconcile",
        "0805a683e5d7e5cc39f0ca60a4d528a84ab7b2e5",
    ),
    "preset": (
        "Quratulain-bilal/spec-kit-preset-explicit-task-dependencies",
        "83421f58e0e6768e5701e839b05ecb5bb57eff8c",
    ),
}
GITIGNORE = """\
# Installed by Ballast (tools/setup)
.ballast/
.agents/skills/ballast-*
.claude/skills/ballast-*
.agents/skills/speckit-*
.claude/skills/speckit-*
docs/policies/*.md
.specify/*
!.specify/memory/
!.specify/bugs/
!.specify/assessments/
.specify/memory/.constitution-template.json
"""
# Representative paths for GITIGNORE: (path, must be ignored).
IGNORE_PROBES = (
    (".ballast/spec_workflow/run.py", True),
    (".ballast/setup/0123456789abcdef/stage/.specify/init-options.json", True),
    (".agents/skills/ballast-feature-intake/SKILL.md", True),
    (".claude/skills/ballast-feature-intake", True),
    ("docs/policies/model-routing.md", True),
    ("docs/policies/project/security.md", False),
    (".agents/skills/speckit-tasks/SKILL.md", True),
    (".claude/skills/speckit-tasks/SKILL.md", True),
    (".specify/scripts/python/common.py", True),
    (".specify/templates/plan-template.md", True),
    (".specify/workflows/workflow-registry.json", True),
    (".specify/workflows/ballast-autonomous/workflow.yml", True),
    (".specify/workflows/ballast-continue/workflow.yml", True),
    (".specify/extensions/ballast/extension.yml", True),
    (".specify/memory/.constitution-template.json", True),
    (".specify/memory/constitution.md", False),
    (".specify/bugs/demo/assessment.md", False),
    (".specify/assessments/demo.md", False),
)
# Installed outputs every installation holds; validation and `--check` require them.
PROMISED = (
    ".ballast/spec_workflow/run.py",
    ".specify/workflows/ballast-feature/workflow.yml",
    ".specify/workflows/ballast-autonomous/workflow.yml",
    ".specify/workflows/ballast-continue/workflow.yml",
)
# Project-owned files that `specify init --force` would overwrite in the stage.
PRESERVED = (".specify/memory/constitution.md",)
CONSTITUTION = ".specify/memory/constitution.md"
WORKFLOW = "ballast-feature"
# Shipped workflows (templates/spec-kit/workflows/<name>), each installed with
# `specify workflow add --dev`: ballast-feature, ballast-autonomous and the
# gate-only ballast-continue.
WORKFLOWS = ("feature", "autonomous", "continue")
# Installed entries: the unit of a switch. `.specify/workflows` is switched
# child by child, so run state (`runs`) and the engine cache stay.
INSTALLED = (
    ".ballast/spec_workflow",
    ".ballast/.setup-version",
    ".specify/scripts",
    ".specify/integrations",
    ".specify/extensions",
    ".specify/presets",
