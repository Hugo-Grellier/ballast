)
KEPT_CHILDREN = ("runs", ".cache")
# Installed skill directories, by prefix, and installed policies.
SKILLS = tuple(
    f"{integration}/skills/{prefix}-*"
    for integration in (".agents", ".claude")
    for prefix in ("ballast", "speckit")
)
POLICIES = "docs/policies/*.md"
# Local state inside installed entries: never recorded, compared or copied.
LOCAL_STATE = (
    ".specify/workflows/runs",
    ".specify/workflows/.cache",
    ".specify/extensions/.cache",
    ".specify/extensions/.backup",
)
# Spec Kit byproducts outside the entry set, dropped with the stage. Any other
# stage output outside the entry set fails validation.
DISCARDED = (".specify/.workflow-install.lock",)
SEEDS = ("ballast.toml", ".gitignore", CONSTITUTION)
# Directories every installed entry lives under; none may be a link.
PARENTS = (
    ".ballast",
    ".ballast/setup",
    ".specify",
    ".specify/memory",
    ".specify/workflows",
    ".agents",
    ".agents/skills",
    ".claude",
