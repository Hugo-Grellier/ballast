def creates_venv(command: str) -> bool:  # noqa: C901 - one small option parser
    """Whether a command (or a `Bash(...)` rule) runs `uv run` or `uv sync` (#114).

    Global options may precede the subcommand. `--no-project`, `--isolated`
    and, for sync, `--dry-run` leave .venv alone, but only among uv's own
    options: the scan stops at the program `uv run` starts.
    """
    tokens = command.replace("(", " ").split()
    for index, part in enumerate(tokens):
        if part != "uv" and not part.endswith("/uv"):
            continue
        rest = iter(tokens[index + 1 :])
        sub = None
        for word in rest:
            if not word.startswith("-"):
                sub = word
                break
            if word in UV_VALUED:
                next(rest, None)
        if sub not in {"run", "sync"}:
            continue
        exempt = {"--no-project", "--isolated"} | (
            {"--dry-run"} if sub == "sync" else set()
        )
        for word in rest:
            if not word.startswith("-"):
                return True  # the program: no exempting option came first
            if word.partition("=")[0] in exempt:
                break
            if word in UV_VALUED:
                next(rest, None)
        else:
            return True
    return False


CHECKS_REMEDY = (
    'add a rule such as "Bash(<command> *)" to [agents.permissions] extra_allow'
    " in ballast.toml, then rerun `ballast setup`"
)
TRUST = "review the checkout, then run `ballast trust`"
PIN_REMEDY = (
    'run `ballast init`, or set [standard] ref = "vX.Y.Z" (a tag or commit of the'
    " standard) in ballast.toml"
)
PROBE_FILES = ("tools/setup", "tools/spec_workflow/launcher.py")


def rule_allows(rule: str, command: str) -> bool:
    """Whether a Claude `Bash(...)` permission rule matches a command.

    An approximation of Claude Code's matching: `*` matches anything, and a
    legacy `prefix:*` rule matches commands starting with the prefix.
    """
    match = re.fullmatch(r"Bash\((.*)\)", rule)
    if match is None:
        return False
    body = match.group(1)
    if body.endswith(":*"):
        return command.startswith(body[:-2])
    pattern = ".*".join(re.escape(part) for part in body.split("*"))
    return re.fullmatch(pattern, command) is not None


def _checks_allowed(root: Path) -> Outcome:
    """Whether Claude agents may run the project's [checks] (#37).

    Codex runs any command inside its sandbox; Claude runs only what its
    allowlist names, so an uncovered check leaves an agent unable to verify
    its own work.
    """
    try:
        config = tomllib.loads(read_config(root))
    except (OSError, ValueError) as error:
        return "inconclusive", f"cannot read ballast.toml: {error}", CHECKS_REMEDY
    checks = config.get("checks")
    commands = checks.get("commands") if isinstance(checks, dict) else None
    if not commands:
        return "passing", "no [checks] commands"
    agents = config.get("agents")
    permissions = agents.get("permissions") if isinstance(agents, dict) else None
    rules = permissions.get("extra_allow") if isinstance(permissions, dict) else None
    rules = [r for r in rules if isinstance(r, str)] if isinstance(rules, list) else []
    uncovered = [
        command
        for command in commands
        if not isinstance(command, str)
        or not any(rule_allows(rule, command) for rule in rules)
    ]
    if not uncovered:
        return "passing", f"extra_allow covers all {len(commands)} [checks] commands"
    detail = "extra_allow does not cover: " + "; ".join(map(str, uncovered))
    if any(re.match(r"[A-Za-z_][A-Za-z0-9_]*=", str(c)) for c in uncovered):
        detail += " (a leading VAR=value never matches an allow rule)"
    return "missing", detail, CHECKS_REMEDY


def _checks_venv(root: Path) -> Outcome:
    """Whether an agent's first [checks] run would create .venv and tamper (#114)."""
    if os.path.lexists(root / ".venv") or not (root / "pyproject.toml").is_file():
        return "passing", "no .venv to create"
    try:
        config = tomllib.loads(read_config(root))
    except (OSError, ValueError) as error:
        return "inconclusive", f"cannot read ballast.toml: {error}", VENV_REMEDY
    agents = config.get("agents")
    permissions = agents.get("permissions") if isinstance(agents, dict) else None
    commands = []
    for table, key in (
        (config.get("checks"), "commands"),
        (permissions, "extra_allow"),
    ):
        value = table.get(key) if isinstance(table, dict) else None
        commands += (
            [v for v in value if isinstance(v, str)] if isinstance(value, list) else []
        )
    for command in commands:
        if creates_venv(command):
            detail = (
                f"{command} creates .venv, a protected input, on an agent's first "
                "run, and this checkout has none: the run would stop as tampered"
            )
            return "missing", detail, VENV_REMEDY
    return "passing", "no configured command creates .venv"


def manifest(standard: Path) -> tuple[tuple[int, ...] | None, set[str], str | None]:
    """Read `(minimum, probes, error)` from a standard's tools/cli.toml, as data."""
    path = standard / "tools/cli.toml"
    if not path.is_file():
        return None, set(), None
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
        minimum = data.get("cli", {}).get("minimum")
        probes = data.get("doctor", {}).get("probes", [])
    except (OSError, ValueError, AttributeError) as error:
        return None, set(), f"cannot read tools/cli.toml: {error}"
    parsed = semver(minimum) if isinstance(minimum, str) else None
    if (minimum is not None and parsed is None) or not (
        isinstance(probes, list) and all(isinstance(p, str) for p in probes)
    ):
        error = "tools/cli.toml has an invalid [cli] minimum or [doctor] probes"
        return None, set(), error
    return parsed, set(probes), None


def _cli_version(minimum: tuple[int, ...] | None, error: str | None) -> Outcome:
    if error:
        remedy = "pin a released version of the standard, then run `ballast setup`"
        return "inconclusive", error, remedy
    if minimum is None or minimum <= semver(VERSION):
        return "passing", f"v{VERSION} meets the pinned version's minimum"
    wanted = "v" + ".".join(map(str, minimum))
    remedy = (
        f"{install_line(wanted)}  (if {wanted} is not published yet, the pin needs "
        "an unreleased CLI: pin a release instead)"
    )
    return (
        "missing",
        f"the pinned version needs CLI {wanted}; this is v{VERSION}",
        remedy,
    )


def _probe_boundary(context: Context) -> tuple[str, str] | None:
    """Why the standard's probes must not run, if they must not."""
    standard = context.standard
    if context.local:
        remedy = "unset BALLAST_STANDARD_DIR to check the pinned version"
        return "local standard: probes not executed", remedy
    paths = [standard, *(standard / p for p in PROBE_FILES)]
    if any(in_working_tree(p.resolve(), context.excluded) for p in paths):
        remedy = (
            f"remove {standard}, then run `ballast setup` with XDG_DATA_HOME "
            "outside any checkout"
        )
        return (
            "standard directory resolves into a working tree or temp directory",
            remedy,
        )
    return None


def _setup_current(context: Context, probes: set[str]) -> Outcome:
    if "setup-check" not in probes:
        remedy = "run `ballast setup` if you have not since changing the pin"
        return (
            "inconclusive",
            "freshness not checked: pinned version predates doctor",
            remedy,
        )
    setup = (context.standard / PROBE_FILES[0]).resolve()
    command = [
        PYTHON,
        "-I",
        "-S",
        str(setup),
        "--project",
        str(context.root),
        "--check",
    ]
    result = probe(command)
    if result is None:
        return "inconclusive", f"setup --check {SLOW}", "ballast setup"
    state = result.stdout.strip() or result.stderr.strip()
    if result.returncode == 0:
        return "passing", f"setup is {state}"
    if result.returncode == 1:
        return "missing", f"setup is {state}", "ballast setup"
    return "inconclusive", f"setup --check failed: {state}", "ballast setup"


def _recorder(status: dict) -> str | None:
    """Name who recorded the baseline; an older launcher omits the key."""
    source = status.get("baseline_source")
    names = {"setup": "ballast setup", "trust": "ballast trust"}
    return names.get(source) if isinstance(source, str) else None


def _reviewed(launcher: Path, root: Path) -> list[str]:
    """List the repositories `ballast trust` reviewed; empty from an older launcher."""
    result = probe([PYTHON, "-I", "-S", str(launcher), "reviewed", "--json"], cwd=root)
    try:
        names = json.loads(result.stdout)["repositories"] if result else []
    except (AttributeError, TypeError, KeyError, ValueError):
        return []
    ok = isinstance(names, list) and all(isinstance(n, str) for n in names)
    return [n for n in names if n.isprintable()] if ok else []


def _refusal_remedy(refusal: str) -> str:
    """Return the operator's next step for a launcher refusal."""
    if "BALLAST_TAMPERED" in refusal:
        return (
            "restore the protected files and recreate .venv, delete BALLAST_TAMPERED, "
            "run `ballast discard-runs`, then " + TRUST
        )
    if refusal.startswith("pinned "):
        return (
            "restore the previous pin in ballast.toml, or fix the cause and rerun "
            "`ballast setup`"
        )
    if "ballast setup" in refusal:
        return "ballast setup"
    if "did not finish" in refusal:
        return "review the checkout, run `ballast discard-runs`, then `ballast trust`"
    return TRUST


def _trust(context: Context, probes: set[str]) -> Outcome:
    if "launcher-status" not in probes:
        return (
            "inconclusive",
            "trust not checked: pinned version predates doctor",
            TRUST,
        )
    launcher = (context.standard / PROBE_FILES[1]).resolve()
    command = [PYTHON, "-I", "-S", str(launcher), "status", "--json"]
    result = probe(command, cwd=context.root)
    try:
        status = json.loads(result.stdout) if result.returncode == 0 else None
        installed, refusal = status["installed"], status["refusal"]
    except (AttributeError, TypeError, KeyError, ValueError):
        detail = f"launcher status {SLOW if result is None else 'was unreadable'}"
        return "inconclusive", detail, TRUST
    if not installed:
        remedy = "ballast setup"
        if declarations(context.standard).prepare:
            remedy += (
                ", or the first `ballast run`, `ledger` or `intake`, which prepares "
                "it from a verified installation on this machine"
            )
        return "missing", "the workflow is not installed in this checkout", remedy
    recorder = _recorder(status)
    recorded = f"baseline recorded by {recorder}" if recorder else None
    names = _reviewed(launcher, context.root)
    listed = "reviewed repositories on this machine: " + ", ".join(names)
    if refusal is None:
        detail = "the launcher accepts this checkout"
        detail += f"; {recorded}" if recorded else ""
        return "passing", detail + (f"; {listed}" if names else "")
    remedy = _refusal_remedy(refusal)
    detail = f"launcher will refuse: {refusal}"
    if recorder:
        detail += f"; the current baseline was recorded by {recorder}"
    return "missing", detail + (f"; {listed}" if names else ""), remedy


def project_checks(context: Context) -> list[Check]:
    """Check the pin, the fetched version, the CLI minimum, setup and trust."""
    results: dict[str, Outcome] = {}

    def finish(skipped: str) -> list[Check]:
        checks = []
        for name, gates in PROJECT_GATES.items():
            status, detail, *remedy = results.get(name, ("skipped", skipped))
            shown = list(gates) if name in results else []
            checks.append(Check(name, "project", status, shown, detail, *remedy))
        return checks

    if not context.project:
        return finish("no ballast.toml found")
    if context.pin_error:
        results["ballast-toml"] = ("missing", context.pin_error, PIN_REMEDY)
        return finish("after fixing ballast.toml")
    results["ballast-toml"] = ("passing", f"ref {context.ref}")
    results["checks-allowed"] = _checks_allowed(context.root)
    results["checks-venv"] = _checks_venv(context.root)
    if context.local and not (context.standard / "tools").is_dir():
        detail = f"local standard {context.standard} is not a checkout of the standard"
        remedy = "set BALLAST_STANDARD_DIR to a checkout of the standard, or unset it"
        results["standard-fetched"] = ("missing", detail, remedy)
        return finish("after fixing BALLAST_STANDARD_DIR")
    if context.local:
        results["standard-fetched"] = (
            "passing",
            f"using local standard {context.standard}",
        )
    elif not context.standard.is_dir():
        detail = f"standard {context.ref} is not fetched"
        installed = installed_detail(context.root, context.ref)
        detail += f"; {installed}" if installed else ""
        results["standard-fetched"] = ("missing", detail, "ballast setup")
        return finish("after `ballast setup`")
    else:
        results["standard-fetched"] = ("passing", str(context.standard))
    minimum, probes, error = manifest(context.standard)
    results["cli-version"] = _cli_version(minimum, error)
    boundary = _probe_boundary(context)
    if boundary:
        results["setup-current"] = results["trust"] = ("inconclusive", *boundary)
    else:
        results["setup-current"] = _setup_current(context, probes)
        results["trust"] = _trust(context, probes)
    return finish("")


def context_for(root: Path) -> Context:
    """Read what doctor needs about the cwd, without writing anything."""
    project = (root / "ballast.toml").is_file()
    excluded = (
        tuple(p.resolve() for p in (root if project else None, git_root(root)) if p)
        + agent_temp_roots()
    )
    ref, error = read_pin(root) if project else (None, None)
    local = os.environ.get("BALLAST_STANDARD_DIR")
    standard = Path(local).absolute() if local else ref and standard_dir(ref)
    return Context(root, project, excluded, ref, error, standard, bool(local))


def diagnose(root: Path) -> tuple[Context, list[Check]]:
    """Run every check concurrently; each has its own time limit."""
    context = context_for(root)
    network = start_network(context)
    with ThreadPoolExecutor(max_workers=len(MACHINE_CHECKS) + 1) as pool:
        futures = {
            name: pool.submit(check, context)
            for name, _, _, check in MACHINE_CHECKS
            if check is not None
        }
        project = pool.submit(project_checks, context)
        checks = []
        for name, gates, remedy, _ in MACHINE_CHECKS:
            status, detail, *override = (
                network() if name == "network" else futures[name].result()
            )
            fix = (
                None if status in {"passing", "skipped"} else (override or [remedy])[0]
            )
            checks.append(Check(name, "machine", status, list(gates), detail, fix))
        checks += project.result()
    return context, checks


def render(context: Context, checks: list[Check]) -> tuple[str, list[str], int]:
    """Build the human report, the blocked commands and the number of gaps."""
    blocking = [c for c in checks if c.status in BLOCKING]
    blocked = sorted({gate for check in blocking for gate in check.gates})
    pin = f" (pinned {context.ref})" if context.ref else ""
    if context.local:
        pin += f", using local standard {context.standard}"
    lines = [f"Ballast doctor (CLI v{VERSION})", ""]
    for scope, title in (
        ("machine", "Machine"),
        ("project", f"Project {context.root}{pin}"),
    ):
        lines.append(title if scope == "machine" or context.project else "Project")
        for check in (c for c in checks if c.scope == scope):
            label = "ok" if check.status == "passing" else check.status
            lines.append(f"  {label:<13}{check.name:<17}{check.detail}")
            if check.status not in {"passing", "skipped"}:
                lines.append(f"{'':<32}needed by: {', '.join(check.gates)}")
                lines.append(f"{'':<32}fix: {check.remedy}")
    lines.append("")
    if blocked:
        gaps = f"{len(blocking)} gap{'s' if len(blocking) > 1 else ''}"
        lines.append(f"Blocked: {', '.join(blocked)} ({gaps}).")
    else:
        lines.append("Everything Ballast needs is in place.")
    # Details carry checkout and tool text: escape control characters so none
    # forges a line or drives the terminal.
    text = "\n".join(
        "".join(c if c.isprintable() else repr(c)[1:-1] for c in line) for line in lines
    )
    return text + "\n", blocked, len(blocking)


def doctor(argv: list[str]) -> int:
    """Report every prerequisite, read-only; exit 1 when a command is blocked."""
    parser = argparse.ArgumentParser(prog="ballast doctor")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args(argv)
    context, checks = diagnose(Path.cwd())
    text, blocked, _ = render(context, checks)
    if arguments.json:
        report = {
            "schema": 1,
            "cli_version": VERSION,
            "project": str(context.root) if context.project else None,
            "standard": {
                "ref": context.ref,
                "path": None if context.standard is None else str(context.standard),
                "local": context.local,
            },
            "checks": [check._asdict() for check in checks],
            "verdict": "blocked" if blocked else "ok",
            "blocked": blocked,
        }
        sys.stdout.write(json.dumps(report, indent=2) + "\n")
    else:
        sys.stdout.write(text)
    return 1 if blocked else 0


# --- update preview (#14) ----------------------------------------------------

SEEDS = ("ballast.toml", ".gitignore", ".specify/memory/constitution.md")
PROTECTED = (".ballast/spec_workflow/", ".specify/")
RESUME_BLOCKER = "finish or discard it before updating"


class PreviewError(Exception):
    """A build or read the preview needs failed; nothing is reported."""


class Declarations(NamedTuple):
    """What a version's tools/cli.toml declares about setup, runs and init."""

    recoverable: bool
    resumes: list[str]
    prepare: bool
    init: bool = False


def declarations(standard: Path) -> Declarations:
    """Read `[setup]`, `[runs] resumes` and `[init] supported`, as data."""
    try:
        data = tomllib.loads((standard / "tools/cli.toml").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return Declarations(recoverable=False, resumes=[], prepare=False)
    setup, runs, adopt = data.get("setup"), data.get("runs"), data.get("init")
    resumes = runs.get("resumes") if isinstance(runs, dict) else None
    if not isinstance(resumes, list):
        resumes = []
    return Declarations(
        recoverable=isinstance(setup, dict) and setup.get("recoverable") is True,
        resumes=[r for r in resumes if isinstance(r, str)],
        prepare=isinstance(setup, dict) and setup.get("prepare") is True,
        init=isinstance(adopt, dict) and adopt.get("supported") is True,
    )


def ignore_block(standard: Path) -> tuple[str | None, list[tuple[str, bool]]]:
    """Read GITIGNORE and IGNORE_PROBES from a version's setup without running it."""
    try:
        tree = ast.parse((standard / "tools/setup").read_text(encoding="utf-8"))
    except (OSError, ValueError, SyntaxError):
        return None, []
    found: dict[str, object] = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1:
            name = getattr(node.targets[0], "id", None)
            if name in {"GITIGNORE", "IGNORE_PROBES"}:
                with contextlib.suppress(ValueError, SyntaxError):
                    found[name] = ast.literal_eval(node.value)
    block = found.get("GITIGNORE")
    probes = found.get("IGNORE_PROBES") or ()
    probes = [
        (p[0], p[1])
        for p in probes
        if isinstance(p, tuple) and len(p) == 2 and isinstance(p[0], str)  # noqa: PLR2004
    ]
    return (block if isinstance(block, str) else None), probes


# Repository config an agent can write must not run a program (a pager,
# core.fsmonitor, hooks) as the operator: the same prefix as tools/setup.
GIT = (
    "git",
    "--no-pager",
    "-c",
    "core.fsmonitor=false",
    "-c",
    "core.hooksPath=/dev/null",
)


def git_output(root: Path, *args: str, data: str | None = None) -> str:
    """Run a read-only git command in root."""
    result = subprocess.run(  # noqa: S603 - fixed git subcommands
        [*GIT, *args],
        cwd=root,
        input=data or "",
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout


def with_ref(config: str, pin: str, ref: str) -> str:
    """ballast.toml with its `[standard] ref` value replaced."""
    pattern = r"(?m)^(\s*ref\s*=\s*)([\"'])" + re.escape(pin) + r"\2"
    changed, count = re.subn(
        pattern, lambda m: m.group(1) + m.group(2) + ref + m.group(2), config, count=1
    )
    if count != 1:
        message = "cannot set the ref in a copy of ballast.toml"
        raise PreviewError(message)
    return changed


def walk(project: Path) -> dict[str, str]:
    """Every file and link a build left, in the installation record's format."""
    found = {}
    for path in sorted(project.rglob("*")):
        relative = path.relative_to(project)
        name = relative.as_posix()
        if (
            relative.parts[0] == ".git"
            or name in SEEDS
            or "__pycache__" in relative.parts
        ):
            continue
        if path.is_symlink():
            found[name] = "link:" + str(path.readlink())
        elif path.is_file():
            found[name] = digest(path)
    return found


def disposable_build(
    root: Path, standard: Path, ref: str, work: Path, block: str | None
) -> tuple[dict[str, str], dict[str, str] | None]:
    """Run a version's own setup in a fresh project; return (walk, record files)."""
    project, state = work / "project", work / "state"
    state.mkdir(parents=True)
    git_output(work, "init", "-q", str(project))
    pin = pinned_ref(root)
    (project / "ballast.toml").write_text(with_ref(read_config(root), pin, ref))
    gitignore = root / ".gitignore"
    ignore = gitignore.read_text(encoding="utf-8") if gitignore.is_file() else ""
    if block and block not in ignore:
        ignore += ("\n" if ignore and not ignore.endswith("\n") else "") + block
    (project / ".gitignore").write_text(ignore)
    constitution = root / SEEDS[2]
    if constitution.is_file():
        (project / SEEDS[2]).parent.mkdir(parents=True)
        shutil.copyfile(constitution, project / SEEDS[2])
    environment = {**os.environ, "XDG_STATE_HOME": str(state)}
    environment.pop("BALLAST_STANDARD_DIR", None)
    result = subprocess.run(  # noqa: S603 - the verified cached version's own setup
        [PYTHON, "-I", "-S", str(standard / "tools/setup"), "--project", str(project)],
        cwd=work,  # never the checkout
        env=environment,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        lines = (result.stderr or result.stdout).strip().splitlines()
        cause = lines[-1] if lines else f"exit status {result.returncode}"
        message = f"the build of {ref} failed: {cause}"
        raise PreviewError(message)
    key = hashlib.sha256(str(project.resolve()).encode()).hexdigest()[:16]
    try:
        record = json.loads((state / "ballast" / key / "installation.json").read_text())
        files = record["files"] if isinstance(record.get("files"), dict) else None
    except (OSError, ValueError, KeyError, AttributeError):
        files = None
    return walk(project), files


def unfinished_runs(root: Path, resumes: list[str]) -> list[dict]:
    """Every run not completed, with its archived format and compatibility."""
    runs = root / ".specify/workflows/runs"
    if not runs.is_dir() or runs.is_symlink():
        return []
    common = git_output(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    archives = Path(common.strip()) / "speckit-runs" if common.strip() else None
    found = []
    for run in sorted(runs.iterdir()):
        if run.is_symlink() or not run.is_dir():
            continue
        try:
            status = json.loads((run / "state.json").read_text()).get("status")
        except (OSError, ValueError, AttributeError):
            status = None
        if status == "completed":
            continue
        try:
            record = json.loads((archives / run.name / "run-format.json").read_text())
            run_format = record.get("format") if isinstance(record, dict) else None
        except (OSError, ValueError, TypeError):
            run_format = None
        run_format = run_format if isinstance(run_format, str) else None
        found.append(
            {
                "id": run.name,
                "status": status if isinstance(status, str) else "unknown",
                "format": run_format,
                "compatible": run_format is not None and run_format in resumes,
            }
        )
    return found


def preview_refusal(root: Path, ref: str) -> str | None:
    """Why the preview must not run at all, if it must not."""
    if not REF.fullmatch(ref) or ".." in ref:
        return f"{ref} is not a tag or commit of the standard"
    if os.environ.get("BALLAST_STANDARD_DIR"):
        return (
            "BALLAST_STANDARD_DIR is set: there is no cache to preview from; unset it"
        )
    _, error = read_pin(root)
    if error:
        return error
    state = operator_state(root)
    if os.path.lexists(state / "setup-attempt.json"):
        return "setup did not finish in this checkout; run `ballast setup` first"
    lock = state / "checkout.lock"
    if lock.is_file() and not lock.is_symlink():
        fd = os.open(lock, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return "ballast setup is running in this checkout; wait for it to finish"
        finally:
            os.close(fd)
    return None


def compare(root: Path, ref: str, target: Path, work: Path) -> dict:
    """Build both sides with one procedure and report the update (FR-015).

    Record against record when both versions keep one, otherwise walk against
    walk of two disposable builds, so both sides always describe one set.
    """
    pin = pinned_ref(root)
    block, probes = ignore_block(target)
    declared = declarations(target)
    target_recoverable, resumes = declared.recoverable, declared.resumes
    pinned = trusted_standard_dir(root, pin)
    both = target_recoverable and pinned.is_dir() and declarations(pinned).recoverable
    after_walk, after_record = disposable_build(
        root, target, ref, work / "after", block
    )
    before = after = None
    live = installation(root)
    if both and after_record is not None and live and live["ref"] == pin:
        setup = str(pinned / "tools/setup")
        check = probe([PYTHON, "-I", "-S", setup, "--project", str(root), "--check"])
        if check is not None and check.returncode == 0:
            before, after = live["files"], after_record
    if before is None:
        pinned = ensure_standard(root, pin)
        before_walk, before_record = disposable_build(
            root, pinned, pin, work / "before", None
        )
        if both and after_record is not None and before_record is not None:
            before, after = before_record, after_record
        else:
            before, after = before_walk, after_walk
    paths = {
        "added": sorted(after.keys() - before.keys()),
        "changed": sorted(
            n for n in after.keys() & before.keys() if after[n] != before[n]
        ),
        "removed": sorted(before.keys() - after.keys()),
    }
    must = [(path, True) for path in after] + probes
    ignored = set(
        git_output(
            root,
            "check-ignore",
            "--no-index",
            "-z",
            "--stdin",
            data="\0".join(p for p, _ in must) + "\0",
        ).split("\0")
    )
    not_ignored = sorted({p for p, wanted in must if wanted != (p in ignored)})
    tracked = set(git_output(root, "ls-files", "-z").split("\0"))
    owned = sorted(
        p
        for p in (*after, *paths["removed"])
        if p in tracked or p.startswith("docs/policies/project/") or p == SEEDS[2]
    )
    return {
        "paths": paths,
        "ignore": {
            "ok": not not_ignored,
            "not_ignored": not_ignored,
            "block": block if not_ignored else None,
        },
        "project_owned_changed": owned,
        "target_recoverable": target_recoverable,
        "resumes": resumes,
    }


def update_report(root: Path, ref: str, target: Path, work: Path) -> dict:
    """Assemble the preview report for moving the pin to `ref`."""
    found = compare(root, ref, target, work)
    pin = pinned_ref(root)
    minimum, _, _ = manifest(target)
    meets = minimum is None or minimum <= semver(VERSION)
    shown_minimum = ".".join(map(str, minimum)) if minimum else None
    runs = unfinished_runs(root, found["resumes"])
    paths = found["paths"]
    changed = sorted({*paths["added"], *paths["changed"], *paths["removed"]})
    protected = ["ballast.toml", *(p for p in changed if p.startswith(PROTECTED))]
    try:
        config = tomllib.loads(read_config(root))
        commands = config.get("checks", {}).get("commands") or []
    except (OSError, ValueError, AttributeError):
        commands = []
    checks = "; ".join(map(str, commands)) if commands else "none configured"
    steps = []
    if not meets:
        wanted = f"v{shown_minimum}"
        steps.append(f"Install the CLI {wanted}: {install_line(wanted)}")
    if not found["ignore"]["ok"]:
        steps.append(
            "Add this block to .gitignore and commit it:\n"
            + (found["ignore"]["block"] or "")
        )
    steps += [
        f'Set ref = "{ref}" under [standard] in ballast.toml, review and commit it',
        "ballast setup",
        "Review the changed protected inputs: " + ", ".join(protected),
        "ballast trust",
        f"Run the project's checks: {checks}",
    ]
    blockers = [
        f"run {run['id']} cannot resume under {ref}: {RESUME_BLOCKER}"
        for run in runs
        if not run["compatible"]
    ]
    if not meets:
        blockers.append(f"this CLI v{VERSION} is below {ref}'s minimum {shown_minimum}")
    if not found["ignore"]["ok"]:
        blockers.append("the ignore rules must change first (see the steps)")
    if found["project_owned_changed"]:
        blockers.append("project-owned files would change")
    return {
        "schema": 1,
        "pinned": pin,
        "installed": installed_ref(root),
        "target": ref,
        "target_recoverable": found["target_recoverable"],
        "cli": {"version": VERSION, "minimum": shown_minimum, "meets": meets},
        "runs": runs,
        "paths": paths,
        "ignore": found["ignore"],
        "project_owned_changed": found["project_owned_changed"],
        "steps": steps,
        "blockers": blockers,
    }


def printable(text: object) -> str:
    """Show checkout text with control characters replaced by `?`."""
    return "".join(c if c.isprintable() else "?" for c in str(text))


def render_preview(report: dict) -> str:
    """Render the human form of an update preview."""
    target = report["target"]
    guarantees = (
        "yes"
        if report["target_recoverable"]
        else "no — a failed setup or rollback to this version can leave the checkout "
        "without a usable installation"
    )
    cli = report["cli"]
    verdict = "meets" if cli["meets"] else "does not meet"
    lines = [
        "Ballast update preview",
        f"  pinned     {report['pinned']}",
        f"  installed  {report['installed'] or 'unknown'}",
        f"  target     {target} (recovery guarantees: {guarantees})",
        (
            f"  CLI        v{cli['version']} {verdict} {target}'s minimum "
            f"{cli['minimum'] or '(none)'}"
        ),
        "",
        "Unfinished runs",
    ]
    for run in report["runs"]:
        resumable = (
            f"can resume under {target}"
            if run["compatible"]
            else f"cannot resume: {RESUME_BLOCKER}"
        )
        shown = run["format"] or "(no format)"
        lines.append(f"  {run['id']}  {run['status']}  {shown}  {resumable}")
    if not report["runs"]:
        lines.append("  none")
    lines += ["", "Installed paths"]
    for kind in ("added", "changed", "removed"):
        lines += [f"  {kind:<8} {path}" for path in report["paths"][kind]]
    if not any(report["paths"].values()):
        lines.append("  none would change")
    ignore = report["ignore"]
    lines.append(
        "Ignore rules: the current .gitignore covers every installed path"
        if ignore["ok"]
        else "Ignore rules: not ignored today: " + ", ".join(ignore["not_ignored"])
    )
    owned = report["project_owned_changed"]
    lines.append(
        "Project-owned files: " + (", ".join(owned) if owned else "none would change")
    )
    lines += ["", "To finish the update"]
    block = ignore["block"] or ""
    for n, step in enumerate(report["steps"], 1):
        if block and step.endswith("\n" + block):
            lines += [f"  {n}. {step[: -len(block) - 1]}", *block.splitlines(), ""]
        else:
            lines.append(f"  {n}. {step}")
    if report["blockers"]:
        lines += ["", "Blocked: " + "; ".join(report["blockers"])]
    # Steps, paths and run state carry checkout text: escape every line so
    # none forges a line or drives the terminal (as doctor's render does).
    return "\n".join(map(printable, lines)) + "\n"


def preview(argv: list[str]) -> int:
    """Report what moving the pin to a version would do, changing nothing."""
    parser = argparse.ArgumentParser(prog="ballast preview")
    parser.add_argument("ref")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args(argv)
    root = Path.cwd()
    refusal = preview_refusal(root, arguments.ref)
    if refusal:
        sys.stderr.write(f"ballast: refusing: {printable(refusal)}\n")
        return EXIT_REFUSED
    target = ensure_standard(root, arguments.ref)
    base = standard_dir(arguments.ref).parent.parent / "preview"
    base.mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(dir=base))
    try:
        report = update_report(root, arguments.ref, target, work)
    except (PreviewError, OSError, ValueError) as error:
        message = f"preview of {arguments.ref} failed: {error}"
        sys.stderr.write(f"ballast: {printable(message)}\n")
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)
        with contextlib.suppress(OSError):
            base.rmdir()
    if arguments.json:
        sys.stdout.write(json.dumps(report, indent=2) + "\n")
    else:
        sys.stdout.write(render_preview(report))
    return 1 if report["blockers"] else 0


def command_standard(root: Path, command: str) -> Path:
    """Return the standard a command runs: local, or the pinned version."""
    local = os.environ.get("BALLAST_STANDARD_DIR")
    if local:
        standard = Path(local).resolve()
        sys.stderr.write(f"ballast: using local standard {standard}\n")
        return standard
    ref = pinned_ref(root)
    if command == "setup":
        return ensure_standard(root, ref)
    standard = trusted_standard_dir(root, ref)
    if not standard.is_dir():
        installed = installed_detail(root, ref)
        fail(
            f"standard {ref} is not fetched; run `ballast setup`"
            + (f"; {installed}" if installed else "")
            + DOCTOR_HINT
        )
    return standard


# --- preparing a new worktree (#15) -----------------------------------------

# The commands whose first use in a checkout with no installation prepares it.
PREPARING = ("run", "ledger", "intake")
RUN_TOOL = ".ballast/spec_workflow/run.py"


def needs_installation(root: Path) -> bool:
    """Nothing is installed (the launcher's test), or a setup journal remains."""
    return not (root / RUN_TOOL).is_file() or os.path.lexists(
        operator_state(root) / "setup-attempt.json"
    )


def before_launcher(root: Path, standard: Path, command: str) -> int:
    """Prepare or refuse an uninstalled checkout before its launcher runs.

    `run`, `ledger` and `intake` prepare it; `trust` and `discard-runs` reach
    the launcher only when the version can prepare, because an older
    launcher answers with usage text that does not name setup (AC-007).
    """
    if command in PREPARING and needs_installation(root):
        return prepare(root, standard)
    if command in {"trust", "discard-runs"} and not (root / RUN_TOOL).is_file():
        return 0 if declarations(standard).prepare else refuse_uninstalled()
    return 0


def refuse_uninstalled() -> int:
    """Refuse a checkout with nothing installed, naming setup."""
    sys.stderr.write(
        "ballast: refusing: nothing is installed in this checkout; run "
        "`ballast setup`\n"
    )
    return EXIT_REFUSED


def prepare(root: Path, standard: Path) -> int:
    """Run the pinned version's `tools/setup --prepare`; its exit status.

    A version that cannot prepare refuses an uninstalled checkout here, and
    leaves a journal-only checkout to the launcher's unfinished-setup refusal.
    The cached version is verified first and never fetched again here.
    """
    if not declarations(standard).prepare:
        return 0 if (root / RUN_TOOL).is_file() else refuse_uninstalled()
    if not os.environ.get("BALLAST_STANDARD_DIR"):
        damaged = damage(standard)
        if damaged is not None:
            sys.stderr.write(
                f"ballast: refusing: the cached standard {standard.name} is damaged "
                f"at {damaged}; run `ballast setup` to fetch it again\n"
            )
            return EXIT_REFUSED
    tool = standard / "tools/setup"
    command = [PYTHON, "-IS", str(tool), "--project", str(root), "--prepare"]
    code = subprocess.run(command, cwd=root, check=False).returncode  # noqa: S603
    return code if code >= 0 else 1  # killed by a signal


# --- adopting a repository (#13) ---------------------------------------------


def refuse(reason: str) -> int:
    """Refuse before running anything from the standard (exit 2)."""
    sys.stderr.write(f"ballast: refusing: {printable(reason)}\n")
    return EXIT_REFUSED


def init_ref(root: Path, wanted: str | None) -> tuple[str | None, str | None]:
    """`(ref, None)` init pins, or `(None, refusal)` (research R2).

    Without ballast.toml: `--ref`, else this CLI's own release. With one: its
    pin, which init never moves.
    """
    if os.path.lexists(root / "ballast.toml"):
        pin, error = read_pin(root)
        if error is not None:
            return None, error
        if wanted is not None and wanted != pin:
            return None, (
                f"ballast.toml pins {pin}; init keeps the pin. To move it, run "
                f"`ballast preview {wanted}`, then edit the pin"
            )
        return pin, None
    ref = wanted or f"v{VERSION}"
    if not REF.fullmatch(ref) or ".." in ref:
        return None, f"{ref} is not a tag or commit of the standard"
    return ref, None


def init(argv: list[str]) -> int:
    """Bootstrap `ballast init`: fetch the chosen version, run its tools/init.

    Every refusal happens before anything from the standard runs and before
    anything is written in the project; only the per-machine cache may be
    filled first (AC-033, FR-020).
    """
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    parser.add_argument("--ref")
    arguments, rest = parser.parse_known_args(argv)
    root = Path.cwd()
    pinned = os.path.lexists(root / "ballast.toml")
    ref, refusal = init_ref(root, arguments.ref)
    if refusal is not None:
        return refuse(refusal)
    local = os.environ.get("BALLAST_STANDARD_DIR")
    if local:
        standard = Path(local).resolve()
        sys.stderr.write(f"ballast: using local standard {standard}\n")
    else:
        standard = ensure_standard(root, ref)
    if not declarations(standard).init:
        if pinned:
            return refuse(
                f"standard {ref}, which ballast.toml pins, has no `init`; move the "
                "pin to a release that has it (`ballast preview REF`, then a "
                "reviewed edit of ballast.toml)"
            )
        return refuse(
            f"standard {ref} has no `init`; pass --ref with a release that has it, "
            "or upgrade the CLI"
        )
    minimum, _, error = manifest(standard)
    if error:
        return refuse(error)
    if minimum is not None and minimum > semver(VERSION):
        wanted = "v" + ".".join(map(str, minimum))
        return refuse(
            f"standard {ref} needs CLI {wanted}; this is v{VERSION}. Install it: "
            f"{install_line(wanted)}"
        )
    tool = standard / "tools/init"
    command = [PYTHON, "-IS", str(tool), "--project", str(root), "--ref", ref]
    os.execv(PYTHON, [*command, *rest])  # noqa: S606
    return 1


def main(argv: list[str]) -> int:  # noqa: PLR0911 - one return per command
    """Fetch on `setup`, otherwise hand the command to the pinned launcher."""
    if not argv:
        fail(USAGE)
    if argv[0] == "--version":
        sys.stdout.write(f"v{VERSION}\n")
        return 0
    if argv[0] == "self-install":
        return self_install(argv[1:])
    if argv[0] == "doctor":
        return doctor(argv[1:])
    if argv[0] == "preview":
        return preview(argv[1:])
    if argv[0] == "init":
        return init(argv[1:])
    root = Path.cwd()
    standard = command_standard(root, argv[0])
    if argv[0] == "setup":
        tool = standard / "tools/setup"
        os.execv(  # noqa: S606
            PYTHON, [PYTHON, "-IS", str(tool), "--project", str(root), *argv[1:]]
        )
    prepared = before_launcher(root, standard, argv[0])
    if prepared != 0:
        return prepared
    launcher = standard / "tools/spec_workflow/launcher.py"
    if not launcher.is_file():
        fail(f"{standard} has no launcher{DOCTOR_HINT}")
    os.execv(PYTHON, [PYTHON, "-IS", str(launcher), *argv])  # noqa: S606
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
