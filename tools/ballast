class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect proves the host answered; following it could download."""

    def redirect_request(self, *_: object) -> None:
        return None


_OPENER = urllib.request.build_opener(_NoRedirect())


def reach(url: str) -> tuple[str, str]:
    """Send one HEAD: `reachable` on 2xx/3xx, `missing` on 404 or no connection."""
    request = urllib.request.Request(url, method="HEAD")  # noqa: S310 - fixed https URL
    try:
        _OPENER.open(request, timeout=PROBE_SECONDS).close()
    except urllib.error.HTTPError as error:
        # The opener never follows a redirect, so a 3xx arrives here.
        if 300 <= error.code < 400:  # noqa: PLR2004
            return "reachable", ""
        kind = "missing" if error.code == 404 else "inconclusive"  # noqa: PLR2004
        return kind, f"{url} returned {error.code}"
    except (OSError, ValueError) as error:
        return "missing", str(getattr(error, "reason", error))
    return "reachable", ""


def start_network(context: Context) -> Callable[[], Outcome]:
    """Probe the hosts setup will contact; return a function that collects."""
    if not context.project:
        return lambda: ("skipped", "no ballast.toml found")
    if context.ref is None or context.local:
        return lambda: (
            "skipped",
            "no fetch to check: no valid pin, or a local standard",
        )
    if context.standard is not None and context.standard.is_dir():
        return lambda: ("skipped", f"standard {context.ref} is already fetched")
    targets = {
        "github.com": ARCHIVE.format(repository=REPOSITORY, ref=context.ref),
        "pypi.org": "https://pypi.org/simple/specify-cli/",
    }
    answers: queue.Queue[tuple[str, tuple[str, str]]] = queue.Queue()
    for host, url in targets.items():
        # Daemon threads: a resolver that never answers cannot hold exit.
        threading.Thread(
            target=lambda h=host, u=url: answers.put((h, reach(u))), daemon=True
        ).start()
    deadline = time.monotonic() + NETWORK_SECONDS

    def collect() -> Outcome:
        results: dict[str, tuple[str, str]] = {}
        while len(results) < len(targets):
            try:
                host, error = answers.get(timeout=max(deadline - time.monotonic(), 0))
            except queue.Empty:
                break
            results[host] = error
        detail = _network_detail(list(targets), results)
        kinds = {kind for kind, _ in results.values()}
        if "missing" in kinds:
            return "missing", detail
        if "inconclusive" in kinds or len(results) < len(targets):
            return "inconclusive", detail
        return "passing", detail

    return collect


def _network_detail(hosts: list[str], results: dict[str, tuple[str, str]]) -> str:
    parts = []
    for host in hosts:
        if host not in results:
            parts.append(f"{host} did not answer within {NETWORK_SECONDS} s")
        else:
            kind, note = results[host]
            shown = {"missing": "unreachable", "inconclusive": "answered with an error"}
            parts.append(
                f"{host} {shown.get(kind, kind)}" + (f" ({note})" if note else "")
            )
    unverified = ["codeload.github.com (archive downloads)"]
    if any(os.environ.get(v) for v in ("UV_INDEX_URL", "UV_DEFAULT_INDEX", "UV_INDEX")):
        unverified.append("the uv index set in the environment")
    return "; ".join(parts) + "; unverified: " + ", ".join(unverified)


