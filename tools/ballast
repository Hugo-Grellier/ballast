)
IDENTITY = re.compile(rf'^REPOSITORY = "{re.escape(REPOSITORY)}"$', re.MULTILINE)
VERSION_LINE = re.compile(r'^VERSION = "([^"]+)"', re.MULTILINE)
SEMVER = re.compile(r"(\d+)\.(\d+)\.(\d+)")
MINIMUM_PYTHON = (3, 11)
PROBE_SECONDS = 3
NETWORK_SECONDS = 5
EXIT_REFUSED = 2
CONFIG_LIMIT = 256 * 1024


def fail(message: str) -> None:
    """Exit with an error message naming this command."""
    sys.exit(f"ballast: {message}")


def read_config(root: Path) -> str:
    """Read ballast.toml: never through a link, a regular file, at most 256 KiB."""
    path = root / "ballast.toml"
    data, reason = b"", "a symbolic link" if path.is_symlink() else None
    if reason is None:
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
        with os.fdopen(os.open(path, flags), "rb") as handle:
            if stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                data = handle.read(CONFIG_LIMIT + 1)
            else:
                reason = "not a regular file"
    if len(data) > CONFIG_LIMIT:
        reason = "larger than 256 KiB"
    if reason is not None:
        raise OSError(reason)
    return data.decode("utf-8")


def read_pin(root: Path) -> tuple[str | None, str | None]:
    """Return `(ref, None)` from the project's ballast.toml, or `(None, error)`."""
    try:
        config = tomllib.loads(read_config(root))
    except (OSError, ValueError) as error:
        return None, f"cannot read ballast.toml: {error}"
    standard = config.get("standard", {})
    ref = standard.get("ref") if isinstance(standard, dict) else None
    if not isinstance(ref, str) or not REF.fullmatch(ref) or ".." in ref:
        return (
            None,
            "ballast.toml needs [standard] ref, a tag or commit of the standard",
        )
    return ref, None


def pinned_ref(root: Path) -> str:
    """Return the validated `[standard] ref` from the project's ballast.toml."""
    ref, error = read_pin(root)
    if error is not None:
        unreadable = error.startswith("cannot read ballast.toml")
        fail(error + (INIT_HINT if unreadable else "") + DOCTOR_HINT)
    return ref


# Agents can write these outside the checkout (Codex's workspace-write
# sandbox); the same list as launcher.TEMP_ROOTS, which a test keeps equal.
TEMP_ROOTS = ("/tmp", "/var/tmp", "/dev/shm")  # noqa: S108 - refused, never used


def agent_temp_roots() -> tuple[Path, ...]:
    """Directories an agent may write outside the checkout."""
    names = {*TEMP_ROOTS, os.environ.get("TMPDIR", "")} - {""}
    return tuple(Path(name).resolve() for name in sorted(names))


def standard_dir(ref: str) -> Path:
    """Return where the given standard version is (or will be) extracted."""
    base = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share"
    return Path(base) / "ballast/standard" / ref


def trusted_standard_dir(root: Path, ref: str) -> Path:
    """standard_dir, refused where an agent could rewrite the launcher there."""
    standard = standard_dir(ref)
    if within(standard.resolve(), (root.resolve(), *agent_temp_roots())):
        fail(
            f"standard directory {standard} is inside the checkout or a temp "
            f"directory, which agents can write; set XDG_DATA_HOME elsewhere"
            f"{DOCTOR_HINT}"
        )
    return standard


# --- the per-machine cache (#14) ---------------------------------------------

# Each cached version holds the record of its content, published with it.
CACHE_RECORD = ".ballast-cache.json"
FETCH_WAIT_SECONDS = 600
CACHE_FAILURES = (OSError, ValueError, EOFError, tarfile.TarError)


def cache_record(tree: Path, ref: str) -> dict:
    """Describe every file and link of an extracted version.

    Bytecode is skipped: Python may write it next to a module it imports.
    """
    files: dict[str, dict] = {}
    for path in sorted(tree.rglob("*")):
        relative = path.relative_to(tree)
        if str(relative) == CACHE_RECORD or "__pycache__" in relative.parts:
            continue
        if path.is_symlink():
            files[relative.as_posix()] = {"link": str(path.readlink())}
        elif path.is_file():
            executable = bool(path.stat().st_mode & 0o111)
            files[relative.as_posix()] = {"sha256": digest(path), "exec": executable}
    fetched = datetime.now(UTC).isoformat(timespec="seconds")
    return {"schema": 1, "ref": ref, "fetched": fetched, "files": files}


def damage(tree: Path) -> str | None:
    """Return the first path where a cached version differs from its record."""
    try:
        record = json.loads((tree / CACHE_RECORD).read_text(encoding="utf-8"))
        expected = record["files"]
        if record.get("schema") != 1 or not isinstance(expected, dict):
            return CACHE_RECORD
    except (OSError, ValueError, KeyError, TypeError):
        return CACHE_RECORD
    found = cache_record(tree, "")["files"]
    differing = [
        n for n in expected.keys() | found.keys() if expected.get(n) != found.get(n)
    ]
    return min(differing) if differing else None


@contextmanager
def fetch_lock(ref: str) -> Iterator[None]:
    """Serialize work on one cached version; the kernel frees it on death."""
    locks = standard_dir(ref).parent / ".locks"
    locks.mkdir(parents=True, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open(locks / f"{ref}.lock", flags, 0o600)
    try:
        deadline = time.monotonic() + FETCH_WAIT_SECONDS
        told = False
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    sys.stderr.write(
                        f"ballast: refusing: another fetch of {ref} still holds "
                        f"{locks / f'{ref}.lock'}; retry when it ends\n"
                    )
                    sys.exit(EXIT_REFUSED)
                if not told:
                    sys.stderr.write(f"ballast: waiting for another fetch of {ref}\n")
                    told = True
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


def fetch(ref: str, target: Path) -> None:
    """Download and extract one version, published with its record by one rename.

    The caller holds the version's fetch lock, so any extraction of this
    version left in the cache belongs to a dead fetch.
    """
    parent = target.parent
    parent.mkdir(parents=True, exist_ok=True)
    for stale in [*parent.glob(f".fetch-{ref}+*"), *parent.glob(f".damaged-{ref}+*")]:
        shutil.rmtree(stale, ignore_errors=True)
    with tempfile.TemporaryDirectory(dir=parent, prefix=f".fetch-{ref}+") as directory:
        archive = Path(directory) / "standard.tar.gz"
        url = ARCHIVE.format(repository=REPOSITORY, ref=ref)
        urllib.request.urlretrieve(url, archive)  # noqa: S310 - fixed https URL
        extracted = Path(directory) / "extracted"
        with tarfile.open(archive, "r:gz") as contents:
            contents.extractall(extracted, filter="data")
        (top,) = extracted.iterdir()
        record = cache_record(top, ref)
        (top / CACHE_RECORD).write_text(json.dumps(record, indent=1) + "\n")
        top.rename(target)


def ensure_standard(root: Path, ref: str) -> Path:
    """Return a verified copy of the version, fetching it once if needed (FR-012)."""
    target = trusted_standard_dir(root, ref)
    if target.is_dir() and damage(target) is None:
        return target
    with fetch_lock(ref):
        damaged = damage(target) if os.path.lexists(target) else None
        if os.path.lexists(target) and damaged is None:
            return target  # another fetch finished while this one waited
        if os.path.lexists(target):
            aside = target.with_name(f".damaged-{ref}+{secrets.token_hex(4)}")
            target.rename(aside)
            shutil.rmtree(aside, ignore_errors=True)
        try:
            fetch(ref, target)
        except CACHE_FAILURES as error:
            if damaged:
                sys.stderr.write(
                    f"ballast: refusing: the cached standard {ref} is damaged at "
                    f"{damaged} and could not be fetched again: {error}\n"
                )
                sys.exit(EXIT_REFUSED)
            fail(
                f"cannot fetch standard {ref}: {error}; the cache and the checkout "
                "are unchanged. Next: check network access (`ballast doctor`), "
                "then rerun the command"
            )
        if damaged:
            sys.stderr.write(
                f"ballast: the cached standard {ref} was damaged ({damaged}); "
                "fetched it again\n"
            )
    return target


def operator_state(root: Path) -> Path:
    """Where setup keeps this checkout's records: launcher.state_dir's path."""
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    key = hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:16]
    return base / "ballast" / key


def installation(root: Path) -> dict | None:
    """Return the installation record setup wrote for this checkout, as data.

    Mirrors launcher.read_record (tests keep them equal): only a record whose
    fingerprint matches the live stamp counts.
    """
    path = operator_state(root) / "installation.json"
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
        stamp = (root / ".ballast/.setup-version").read_text(encoding="utf-8").strip()
    except (OSError, ValueError):
        return None
    if (
        not isinstance(record, dict)
        or record.get("fingerprint") != stamp
        or not isinstance(record.get("ref"), str)
        or not isinstance(record.get("files"), dict)
    ):
        return None
    return record


def installed_ref(root: Path) -> str | None:
    """Return the version setup recorded for this checkout, if the record is valid."""
    record = installation(root)
    return record["ref"] if record else None


def installed_detail(root: Path, pin: str) -> str:
    """`installed A, pinned B` and both recoveries, when they differ (AC-008)."""
    installed = installed_ref(root)
    if installed is None or installed == pin:
        return ""
    return (
        f'installed {installed}, pinned {pin}: restore ref = "{installed}" in '
        "ballast.toml, or fix the cause and rerun `ballast setup`"
    )


def install_line(tag: str) -> str:
    """Return the documented install line for one release tag."""
    return INSTALL_LINE.replace("vX.Y.Z", tag)


def semver(text: str) -> tuple[int, int, int] | None:
    """Parse `X.Y.Z`, or return None."""
    match = SEMVER.fullmatch(text)
    return tuple(int(part) for part in match.groups()) if match else None


def ballast_version(path: Path) -> tuple[bool, str | None]:
    """Whether a file is a Ballast CLI, and its version when it declares one."""
    try:
        text = path.read_bytes().decode("utf-8", "replace")
    except OSError:
        return False, None
    match = VERSION_LINE.search(text)
    return bool(IDENTITY.search(text)), match.group(1) if match else None


def within(path: Path, roots: tuple[Path, ...]) -> bool:
    """Whether a resolved path lies in one of roots."""
    return any(path.is_relative_to(root) for root in roots)


def in_working_tree(path: Path, roots: tuple[Path, ...] = ()) -> bool:
    """Whether a resolved path lies in one of roots or under a `.git` parent."""
    return within(path, roots) or any(
        os.path.lexists(parent / ".git") for parent in (path, *path.parents)
    )


def digest(path: Path) -> str:
    """SHA-256 of a file."""
    return hashlib.sha256(path.read_bytes()).hexdigest()


def python_version(python: str) -> str | None:
    """`X.Y` of an interpreter, None when it is missing or does not answer."""
    result = probe(
        [python, "-I", "-S", "-c", "import sys; print(*sys.version_info[:2], sep='.')"]
    )
    if result is None or result.returncode != 0:
        return None
    return result.stdout.strip()


def python_ok(version: str | None) -> bool:
    """Whether an `X.Y` version meets the minimum."""
    parts = tuple(int(p) for p in version.split(".")) if version else ()
    return parts >= MINIMUM_PYTHON


def on_path(directory: Path, path: str) -> bool:
    """Whether a directory is an entry of a PATH value."""
    target = directory.resolve()
    return any(
        entry and Path(entry).resolve() == target for entry in path.split(os.pathsep)
    )


def self_install(argv: list[str]) -> int:
    """Install this file's own bytes atomically as DIR/ballast."""
    parser = argparse.ArgumentParser(prog="ballast self-install")
    parser.add_argument("--dir", type=Path, default=Path.home() / ".local/bin")
    parser.add_argument("--force", action="store_true")
    arguments = parser.parse_args(argv)
    source = Path(__file__).read_bytes()
    directory = arguments.dir.expanduser().absolute()
    if in_working_tree(directory.resolve()):
        sys.stderr.write(
            f"ballast: {directory} is inside a Git working tree; "
            "install outside any checkout\n"
        )
        return EXIT_REFUSED
    target = directory / "ballast"
    previous: str | None = None
    message = f"installed ballast v{VERSION} at {target}"
    if os.path.lexists(target):
        # A link is never followed or kept: it could point into a checkout.
        link = target.is_symlink()
        is_ballast, previous = (False, None) if link else ballast_version(target)
        if (target.is_dir() and not link) or not (is_ballast or arguments.force):
            sys.stderr.write(
                f"ballast: {target} is not a Ballast command; "
                "rerun with --force to replace it\n"
            )
            return EXIT_REFUSED
        if is_ballast and previous == VERSION and target.read_bytes() == source:
            sys.stdout.write(f"ballast v{VERSION} is already installed at {target}\n")
            return report_environment(directory)
        shown = f"v{previous}" if previous else "(previous version unknown)"
        if not is_ballast:
            shown = "a symbolic link" if link else "a non-Ballast file"
        message = f"replaced ballast {shown} with v{VERSION} at {target}"
    temporary: Path | None = None
    try:
        directory.mkdir(mode=0o755, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            dir=directory, prefix=".ballast-", delete=False
        ) as handle:
            temporary = Path(handle.name)
            handle.write(source)
            handle.flush()
            os.fchmod(handle.fileno(), 0o755)
            os.fsync(handle.fileno())
        # Verify before the rename; nothing is read after it.
        if digest(temporary) != hashlib.sha256(source).hexdigest():
            mismatch = "the written file does not match the source"
            raise OSError(mismatch)  # noqa: TRY301
        temporary.replace(target)
    except OSError as error:
        sys.stderr.write(f"ballast: cannot install: {error}\n")
        return 1
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    sys.stdout.write(message + "\n")
    return report_environment(directory)


def report_environment(directory: Path) -> int:
    """Say how to reach the installed command, and whether it can run."""
    caller = os.environ.get("BALLAST_CALLER_PATH") or os.environ.get("PATH", "")
    if not on_path(directory, caller):
        sys.stdout.write(
            f"{directory} is not on PATH; add this line to your shell configuration:\n"
            f'  export PATH="{directory}:$PATH"\n'
        )
    version = python_version(PYTHON)
    if not python_ok(version):
        sys.stdout.write(
            f"warning: ballast runs under {PYTHON}, which is "
            f"{version or 'missing'}; it needs Python 3.11 or newer\n"
        )
    return 0


