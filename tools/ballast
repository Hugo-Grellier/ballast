class Check(NamedTuple):
    """One prerequisite and what doctor observed."""

    name: str
    scope: str
    status: str
    gates: list[str]
    detail: str
    remedy: str | None = None


class Context(NamedTuple):
    """What the checks may look at; nothing here is ever written."""

    root: Path
    project: bool
    excluded: tuple[Path, ...]
    ref: str | None = None
    pin_error: str | None = None
    standard: Path | None = None
