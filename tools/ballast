STATUSES = ("passing", "missing", "unsupported", "inconclusive", "skipped")
BLOCKING = frozenset({"missing", "unsupported"})
EVERY = ("ballast setup", "ballast trust", "ballast run", "ballast ledger")
HEADLESS = ("ballast run (headless steps)",)
LINGER = 'loginctl enable-linger "$USER", then log in again'


class Check(NamedTuple):
    """One prerequisite and what doctor observed."""

    name: str
    scope: str
    status: str
    gates: list[str]
    detail: str
    remedy: str | None = None


class Context(NamedTuple):
    """What the checks may look at; nothing here is ever written."""

    root: Path
    project: bool
    excluded: tuple[Path, ...]
    ref: str | None = None
    pin_error: str | None = None
    standard: Path | None = None
    local: bool = False


def git_root(path: Path) -> Path | None:
    """Find the enclosing Git working tree without running Git."""
    for parent in (path, *path.parents):
        if os.path.lexists(parent / ".git"):
            return parent
    return None


def resolve_program(name: str, excluded: tuple[Path, ...]) -> tuple[str | None, str]:
    """Find a program on PATH, never inside the project or any Git working tree."""
    kept, dropped = [], []
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry or not Path(entry).is_absolute():
            dropped.append(entry or ".")
            continue
        resolved = Path(entry).resolve()
        (dropped if in_working_tree(resolved, excluded) else kept).append(entry)
    shadow = None
    for entry in kept:
        found = shutil.which(name, path=entry)
        if found is None:
            continue
        program = Path(found).resolve()
        if not in_working_tree(program, excluded):
            return str(program), ""
        shadow = found
    shadow = shadow or shutil.which(name, path=os.pathsep.join(dropped))
    note = (
        f"; ignored {name} found only in the checkout, another Git working tree,"
        " a temp directory or a relative PATH entry"
    )
    return None, note if shadow else ""


def probe(
    argv: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None
) -> subprocess.CompletedProcess[str] | None:
    """Run a read-only probe; None when it does not answer in time."""
    environment = {
        **(os.environ if env is None else env),
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    try:
        return subprocess.run(  # noqa: S603 - resolved program, fixed arguments
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=PROBE_SECONDS,
            cwd=cwd,
            env=environment,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None
    except OSError as error:
        return subprocess.CompletedProcess(argv, 127, "", str(error))


SLOW = f"did not answer within {PROBE_SECONDS} s"
Outcome = tuple[str, str] | tuple[str, str, str]


def _check_python(_: Context) -> Outcome:
    if not Path(PYTHON).is_file():
        return "missing", f"{PYTHON} not found"
    version = python_version(PYTHON)
    if version is None:
        return "inconclusive", f"{PYTHON} {SLOW} or failed"
    return ("passing" if python_ok(version) else "missing"), f"{PYTHON} {version}"


def _check_cli(context: Context) -> Outcome:
    program, note = resolve_program("ballast", context.excluded)
    if program is None:
        return "missing", "no `ballast` on PATH" + note
    is_ballast, version = ballast_version(Path(program))
    if not is_ballast:
        return "missing", f"{program} is not the Ballast CLI" + note
    return "passing", f"{program} v{version or '(unknown)'}"


def _presence(name: str) -> Callable[[Context], Outcome]:
    def check(context: Context) -> Outcome:
        program, note = resolve_program(name, context.excluded)
        return (
            ("passing", program) if program else ("missing", f"{name} not found" + note)
        )

    return check


# Branch synchronization (#18) needs `merge-tree --merge-base` and `--attr-source`.
GIT_FLOOR = (2, 41)


def _check_git(context: Context) -> Outcome:
    program, note = resolve_program("git", context.excluded)
    if program is None:
        return "missing", "git not found" + note
    result = probe([program, "version"])
    if result is None:
        return "inconclusive", f"git version {SLOW}"
    match = re.match(r"git version (\d+)\.(\d+)", result.stdout)
    if match is None:
        return "inconclusive", f"{program}: version unknown"
    version = (int(match.group(1)), int(match.group(2)))
    if version < GIT_FLOOR:
        shown = f"{version[0]}.{version[1]}"
        return "missing", f"{program}: git {shown} is older than 2.41"
    return "passing", f"{program} {version[0]}.{version[1]}"


def _check_linux(_: Context) -> Outcome:
    if sys.platform == "linux":
        return "passing", "linux"
    return "unsupported", f"{sys.platform}: headless steps need Linux"


def _check_systemd_user(context: Context) -> Outcome:
    if sys.platform != "linux":
        return "unsupported", "headless steps need Linux"
    program, note = resolve_program("systemctl", context.excluded)
    if program is None:
        return "missing", "systemctl not found" + note
    result = probe([program, "--user", "show", "--property=Version"])
    if result is None:
        return "inconclusive", f"systemctl --user {SLOW}"
    if result.returncode != 0:
        return "missing", "no systemd user session"
    return "passing", "systemd user session available"


def _check_systemd_run(context: Context) -> Outcome:
    if sys.platform != "linux":
        return "unsupported", "headless steps need Linux"
    program, note = resolve_program("systemd-run", context.excluded)
    if program is None:
        return "missing", "systemd-run not found" + note
    command = [program, "--user", "--scope", "--quiet", "--collect"]
    command += ["--setenv=PATH=/usr/bin:/bin", "/usr/bin/true"]
    result = probe(command, env={**os.environ, "PATH": "/usr/bin:/bin"})
    if result is None:
        return "inconclusive", f"systemd-run {SLOW}"
    if result.returncode != 0:
        return (
            "unsupported",
            "systemd-run is present, but a transient scope did not start",
        )
    return "passing", "transient user scopes start"


def _check_agent(context: Context) -> Outcome:
    resolved = {n: resolve_program(n, context.excluded) for n in ("claude", "codex")}
    found = [name for name, (program, _) in resolved.items() if program]
    if found:
        # The agent write boundary (#34): what program lookup never trusts.
        writable = ", ".join(str(path) for path in agent_temp_roots())
        boundary = f"agents can write the checkout and {writable}, never trusted"
        return "passing", f"{', '.join(found)}; {boundary}"
    notes = "".join(note for _, note in resolved.values())
    return "missing", "neither claude nor codex found" + notes


def _check_gh(context: Context) -> Outcome:
    program, note = resolve_program("gh", context.excluded)
    if program is None:
        return "missing", "gh not found" + note
    # Only the exit status is used: the output may name an account or token.
    result = probe([program, "auth", "status"])
    if result is None:
        return "inconclusive", f"gh auth status {SLOW}", "gh auth login"
    if result.returncode != 0:
        return "missing", "gh is not authenticated", "gh auth login"
    return "passing", "gh authenticated"


