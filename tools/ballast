INSTALL_LINE = (
    "(c=$PATH; PATH=/usr/local/bin:/usr/bin:/bin; v=vX.Y.Z;"
    " u=https://github.com/Hugo-Grellier/ballast/releases/download/$v;"
    " d=$(TMPDIR=/tmp mktemp -d)"
    ' && { curl -q -fsSL -o "$d/ballast" "$u/ballast"'
    ' && curl -q -fsSL -o "$d/ballast.sha256" "$u/ballast.sha256"'
    ' || { echo "ballast: cannot download $v from $u; nothing installed" >&2;'
    " false; }; }"
    ' && { [ "$(cut -d" " -f1 "$d/ballast.sha256")"'
    ' = "$(sha256sum <"$d/ballast" | cut -d" " -f1)" ]'
