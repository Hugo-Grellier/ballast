#!/usr/bin/python3 -IS
"""Run the standard version a project pins, from outside its checkout.

Install once per machine with the line in the README, which downloads a
released copy of this file, checks its SHA-256 and runs `self-install`:

    ballast self-install [--dir DIR] [--force]   # install this file as DIR/ballast
    ballast --version
    ballast doctor [--json]    # read-only check of every prerequisite

Then, from a project root whose ballast.toml has `[standard] ref = "..."`:

    ballast setup              # fetch that version, run its tools/setup
    ballast trust              # after reviewing the checkout
    ballast run start|resume ...
    ballast ledger ...

Each version is extracted once into $XDG_DATA_HOME/ballast/standard/<ref>/.
Only `setup` downloads; every other command runs the launcher
of an already fetched version. The repository is fixed here, so a project can
choose a version but never a source. Set BALLAST_STANDARD_DIR to a local
checkout of this repository to develop the standard itself; from such a
checkout, `install -m 0755 tools/ballast ~/.local/bin/ballast` also installs it.
`doctor` writes nothing, downloads nothing and runs only the read-only probes a
fetched version declares in its tools/cli.toml.
"""

from __future__ import annotations

import sys

if sys.version_info < (3, 11):  # noqa: UP036 - the guard is the point
    found = ".".join(str(part) for part in sys.version_info[:2])
    sys.stderr.write(f"ballast: needs Python 3.11 or newer (found {found})\n")
    sys.exit(1)

