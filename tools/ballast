REPOSITORY = "Hugo-Grellier/ballast"
VERSION = "0.2.0"  # x-release-please-version
ARCHIVE = "https://github.com/{repository}/archive/{ref}.tar.gz"
REF = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")
PYTHON = "/usr/bin/python3"
USAGE = (
    "usage: ballast setup | trust | run ... | ledger ... | doctor [--json]"
    " | self-install [--dir DIR] [--force] | --version"
)
DOCTOR_HINT = "; run `ballast doctor` for details"
# The README's install line, with the version as a placeholder. A test keeps
# both copies identical.
INSTALL_LINE = (
    "(c=$PATH; PATH=/usr/local/bin:/usr/bin:/bin; v=vX.Y.Z;"
    " u=https://github.com/Hugo-Grellier/ballast/releases/download/$v;"
    " d=$(TMPDIR=/tmp mktemp -d)"
    ' && { curl -q -fsSL -o "$d/ballast" "$u/ballast"'
    ' && curl -q -fsSL -o "$d/ballast.sha256" "$u/ballast.sha256"'
    ' || { echo "ballast: cannot download $v from $u; nothing installed" >&2;'
    " false; }; }"
    ' && { [ "$(cut -d" " -f1 "$d/ballast.sha256")"'
    ' = "$(sha256sum <"$d/ballast" | cut -d" " -f1)" ]'
    ' || { echo "ballast: checksum mismatch for $v; nothing installed" >&2; false; }; }'
    ' && BALLAST_CALLER_PATH="$c" /usr/bin/python3 -I -S "$d/ballast" self-install)'
)
IDENTITY = re.compile(rf'^REPOSITORY = "{re.escape(REPOSITORY)}"$', re.MULTILINE)
VERSION_LINE = re.compile(r'^VERSION = "([^"]+)"', re.MULTILINE)
SEMVER = re.compile(r"(\d+)\.(\d+)\.(\d+)")
MINIMUM_PYTHON = (3, 11)
PROBE_SECONDS = 3
NETWORK_SECONDS = 5
EXIT_REFUSED = 2


def fail(message: str) -> None:
    """Exit with an error message naming this command."""
    sys.exit(f"ballast: {message}")


def read_pin(root: Path) -> tuple[str | None, str | None]:
    """Return `(ref, None)` from the project's ballast.toml, or `(None, error)`."""
    try:
        config = tomllib.loads((root / "ballast.toml").read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        return None, f"cannot read ballast.toml: {error}"
    standard = config.get("standard", {})
    ref = standard.get("ref") if isinstance(standard, dict) else None
    if not isinstance(ref, str) or not REF.fullmatch(ref) or ".." in ref:
        return (
            None,
            "ballast.toml needs [standard] ref, a tag or commit of the standard",
        )
    return ref, None


def pinned_ref(root: Path) -> str:
    """Return the validated `[standard] ref` from the project's ballast.toml."""
    ref, error = read_pin(root)
    if error is not None:
        fail(error + DOCTOR_HINT)
    return ref


def standard_dir(ref: str) -> Path:
    """Return where the given standard version is (or will be) extracted."""
    base = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share"
    return Path(base) / "ballast/standard" / ref


def fetch(ref: str, target: Path) -> None:
    """Download and extract one version."""
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=target.parent) as directory:
        archive = Path(directory) / "standard.tar.gz"
        url = ARCHIVE.format(repository=REPOSITORY, ref=ref)
        urllib.request.urlretrieve(url, archive)  # noqa: S310 - fixed https URL
        extracted = Path(directory) / "extracted"
        with tarfile.open(archive, "r:gz") as contents:
            contents.extractall(extracted, filter="data")
        (top,) = extracted.iterdir()
        top.rename(target)


def install_line(tag: str) -> str:
    """Return the documented install line for one release tag."""
    return INSTALL_LINE.replace("vX.Y.Z", tag)


def semver(text: str) -> tuple[int, int, int] | None:
    """Parse `X.Y.Z`, or return None."""
    match = SEMVER.fullmatch(text)
    return tuple(int(part) for part in match.groups()) if match else None


def ballast_version(path: Path) -> tuple[bool, str | None]:
    """Whether a file is a Ballast CLI, and its version when it declares one."""
    try:
        text = path.read_bytes().decode("utf-8", "replace")
    except OSError:
        return False, None
    match = VERSION_LINE.search(text)
    return bool(IDENTITY.search(text)), match.group(1) if match else None


def within(path: Path, roots: tuple[Path, ...]) -> bool:
    """Whether a resolved path lies in one of roots."""
    return any(path.is_relative_to(root) for root in roots)


def in_working_tree(path: Path, roots: tuple[Path, ...] = ()) -> bool:
    """Whether a resolved path lies in one of roots or under a `.git` parent."""
    return within(path, roots) or any(
        os.path.lexists(parent / ".git") for parent in (path, *path.parents)
    )


def digest(path: Path) -> str:
    """SHA-256 of a file."""
    return hashlib.sha256(path.read_bytes()).hexdigest()


def python_version(python: str) -> str | None:
    """`X.Y` of an interpreter, None when it is missing or does not answer."""
    result = probe(
        [python, "-I", "-S", "-c", "import sys; print(*sys.version_info[:2], sep='.')"]
    )
    if result is None or result.returncode != 0:
        return None
    return result.stdout.strip()


def python_ok(version: str | None) -> bool:
    """Whether an `X.Y` version meets the minimum."""
    parts = tuple(int(p) for p in version.split(".")) if version else ()
    return parts >= MINIMUM_PYTHON


def on_path(directory: Path, path: str) -> bool:
    """Whether a directory is an entry of a PATH value."""
    target = directory.resolve()
    return any(
        entry and Path(entry).resolve() == target for entry in path.split(os.pathsep)
    )


def self_install(argv: list[str]) -> int:
    """Install this file's own bytes atomically as DIR/ballast."""
    parser = argparse.ArgumentParser(prog="ballast self-install")
    parser.add_argument("--dir", type=Path, default=Path.home() / ".local/bin")
    parser.add_argument("--force", action="store_true")
    arguments = parser.parse_args(argv)
    source = Path(__file__).read_bytes()
    directory = arguments.dir.expanduser().absolute()
    if in_working_tree(directory.resolve()):
        sys.stderr.write(
            f"ballast: {directory} is inside a Git working tree; "
            "install outside any checkout\n"
        )
        return EXIT_REFUSED
    target = directory / "ballast"
    previous: str | None = None
    message = f"installed ballast v{VERSION} at {target}"
    if os.path.lexists(target):
        # A link is never followed or kept: it could point into a checkout.
        link = target.is_symlink()
        is_ballast, previous = (False, None) if link else ballast_version(target)
        if (target.is_dir() and not link) or not (is_ballast or arguments.force):
            sys.stderr.write(
                f"ballast: {target} is not a Ballast command; "
                "rerun with --force to replace it\n"
            )
            return EXIT_REFUSED
        if is_ballast and previous == VERSION and target.read_bytes() == source:
            sys.stdout.write(f"ballast v{VERSION} is already installed at {target}\n")
            return report_environment(directory)
        shown = f"v{previous}" if previous else "(previous version unknown)"
        if not is_ballast:
            shown = "a symbolic link" if link else "a non-Ballast file"
        message = f"replaced ballast {shown} with v{VERSION} at {target}"
    temporary: Path | None = None
    try:
        directory.mkdir(mode=0o755, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            dir=directory, prefix=".ballast-", delete=False
        ) as handle:
            temporary = Path(handle.name)
            handle.write(source)
            handle.flush()
            os.fchmod(handle.fileno(), 0o755)
            os.fsync(handle.fileno())
        # Verify before the rename; nothing is read after it.
        if digest(temporary) != hashlib.sha256(source).hexdigest():
            mismatch = "the written file does not match the source"
            raise OSError(mismatch)  # noqa: TRY301
        temporary.replace(target)
    except OSError as error:
        sys.stderr.write(f"ballast: cannot install: {error}\n")
        return 1
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    sys.stdout.write(message + "\n")
    return report_environment(directory)


def report_environment(directory: Path) -> int:
    """Say how to reach the installed command, and whether it can run."""
    caller = os.environ.get("BALLAST_CALLER_PATH") or os.environ.get("PATH", "")
    if not on_path(directory, caller):
        sys.stdout.write(
            f"{directory} is not on PATH; add this line to your shell configuration:\n"
            f'  export PATH="{directory}:$PATH"\n'
        )
    version = python_version(PYTHON)
    if not python_ok(version):
        sys.stdout.write(
            f"warning: ballast runs under {PYTHON}, which is "
            f"{version or 'missing'}; it needs Python 3.11 or newer\n"
        )
    return 0


